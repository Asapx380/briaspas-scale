NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave
FOURSQUARE_PLACES_API_KEY=sua-chave-de-servico-foursquare
PEXELS_API_KEY=sua-chave-gratuita-pexels
GROQ_API_KEY=sua-chave-da-groq
# Opcional: altere somente se quiser testar outro modelo compatível da Groq.
GROQ_SITE_MODEL=openai/gpt-oss-120b
# Tarifas do modelo por milhão de tokens; consulte a tabela atual do provedor.
GROQ_INPUT_USD_PER_MILLION=
GROQ_OUTPUT_USD_PER_MILLION=
OPENAI_API_KEY=sua-chave-da-openai
# Compare gpt-5.6-luna e gpt-5.6-terra antes de definir o modelo de produção.
OPENAI_SITE_MODEL=gpt-5.6-terra
# Valores: groq | openai | gemini
SITE_GENERATOR_PROVIDER=groq
# Opcional: custos por 1 milhão de tokens para o painel financeiro.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
# Gemini 3 Flash gratuito está disponível como preview na API no momento.
GEMINI_API_KEY=sua-chave-do-google-ai-studio
GEMINI_SITE_MODEL=gemini-3-flash-preview
# Opcional: o tier gratuito não precisa de tarifas; use ao migrar para plano pago.
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
# Chave sem faturamento para protótipos. Quando preenchida, tem prioridade sobre a chave padrão.
GOOGLE_MAPS_DEMO_API_KEY=sua-chave-de-demonstracao
# Opcional: mantenha vazio enquanto o faturamento do Google Places estiver pausado.
GOOGLE_PLACES_API_KEY=sua-chave-da-places-api

# Domínios personalizados (Vercel). Nunca use NEXT_PUBLIC_ nestas chaves.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
PRIMARY_APP_HOST=localhost

# Google Agenda OAuth. A chave de criptografia deve ter 32 bytes em base64.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
