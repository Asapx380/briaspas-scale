#!/usr/bin/env bash
# Block agent authors and strip agent Co-authored-by trailers.
# Keeps GitHub Contributors people-only (Wesley / team emails).
set -euo pipefail

msg_file="${1:-}"
if [[ -z "$msg_file" || ! -f "$msg_file" ]]; then
  exit 0
fi

tmp="$(mktemp)"
# Remove Co-authored-by lines that credit Cursor / cursoragent / generic agents.
grep -Eiv '^[[:space:]]*Co-authored-by:[[:space:]].*(Cursor|cursoragent|@cursor\.com)' "$msg_file" >"$tmp" || true
mv "$tmp" "$msg_file"

is_agent_ident() {
  local ident="${1:-}"
  echo "$ident" | grep -Eiq 'cursoragent|cursor agent|@cursor\.com'
}

author_ident="$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)"
committer_ident="$(git var GIT_COMMITTER_IDENT 2>/dev/null || true)"

if is_agent_ident "$author_ident" || is_agent_ident "$committer_ident"; then
  cat >&2 <<'EOF'
error: commit blocked — author/committer looks like a Cursor agent.

Set a human identity before committing, e.g.:
  git config user.name "Wesley Luther"
  git config user.email "wesleyluther830@gmail.com"

Or for one commit:
  GIT_AUTHOR_NAME="Wesley Luther" \
  GIT_AUTHOR_EMAIL="wesleyluther830@gmail.com" \
  GIT_COMMITTER_NAME="Wesley Luther" \
  GIT_COMMITTER_EMAIL="wesleyluther830@gmail.com" \
  git commit ...
EOF
  exit 1
fi

exit 0
